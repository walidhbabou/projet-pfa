FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Pin specific versions to avoid deprecation warnings
COPY requirements.txt .
RUN python -m pip install --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

# Copy Rasa files and models
COPY . .

# Environment variables to suppress warnings
ENV SQLALCHEMY_SILENCE_UBER_WARNING=1 \
    PYTHONWARNINGS="ignore::DeprecationWarning" \
    RASA_MODEL_PATH=/app/models

EXPOSE 5005

# Default command (can be overridden by Kubernetes)
CMD ["rasa", "run", "-m", "/app/models/20250426-033857-visible-atmosphere.tar.gz", "--enable-api", "--cors", "*", "--debug"]
