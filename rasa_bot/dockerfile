FROM python:3.10-slim

WORKDIR /app

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/cache/apt/*

# Copy requirements
COPY requirements.txt .

# Install Python packages en plusieurs étapes pour économiser l'espace
RUN python -m pip install --upgrade pip --no-cache-dir && \
    pip install --no-cache-dir wheel setuptools && \
    pip install --no-cache-dir --no-deps rasa && \
    pip install --no-cache-dir -r requirements.txt && \
    pip cache purge && \
    find /usr/local/lib/python3.10 -name "*.pyc" -delete && \
    find /usr/local/lib/python3.10 -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# Copy Rasa files
COPY . .

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 5005

CMD ["rasa", "run", "-m", "/app/models", "--enable-api", "--cors", "*"]
